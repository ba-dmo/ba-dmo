@inject BA.Dmo.Application.Shared.Shell.IShellService Shell
@{
    // Global header — reference dmo-app-header anatomy (DMO §6): logo +
    // page identity + user block (name + profile_title, presentation only,
    // UD-02) with the account trigger. Derivation/grants untouched (U-07).
    var shell = Shell.Current;
    var pageTitle = ViewData["Title"] as string;
}
<header class="app-header dmo-app-header">
    <a class="app-brand" href="/" aria-label="BA DMO — início">
        <img class="dmo-app-header__logo" src="~/assets/ba-logo.png" alt="BA" />
        BA DMO
    </a>
    @if (!string.IsNullOrWhiteSpace(pageTitle))
    {
        <div class="dmo-app-header__page">
            <h1>@pageTitle</h1>
        </div>
    }
    @if (shell is not null)
    {
        <div class="dmo-app-header__user" data-testid="shell-user">
            <strong data-user-profile-name>@shell.DisplayName</strong>
            @if (!string.IsNullOrWhiteSpace(shell.ProfileTitle))
            {
                <span data-user-profile-title data-testid="shell-profile-title">@shell.ProfileTitle</span>
            }
            <a href="/logout" data-testid="shell-logout">Terminar sessão</a>
        </div>
    }
</header>
