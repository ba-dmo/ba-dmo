@page "/admin/users"
@model BA.Dmo.Web.Pages.Admin.Users.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AdminGerir)]
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BA DMO — Utilizadores internos</title>
</head>
<body>
    <main>
        <h1>Utilizadores internos</h1>
        <p><a href="/admin">Administração</a></p>
        <form method="get">
            <label for="q">Pesquisa</label>
            <input id="q" name="q" type="text" value="@Model.Search" />
            <button type="submit">Pesquisar</button>
            <a href="/admin/users/create">Criar utilizador</a>
        </form>
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Título</th>
                    <th>Template</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.DisplayName</td>
                        <td>@user.ProfileTitle</td>
                        <td>@user.TemplateId</td>
                        <td>@(user.Active ? "Ativo" : "Inativo")</td>
                        <td><a href="/admin/users/edit?id=@Uri.EscapeDataString(user.ActorId)">Editar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </main>
</body>
</html>
