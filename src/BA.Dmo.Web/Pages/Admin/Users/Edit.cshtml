@page "/admin/users/edit"
@model BA.Dmo.Web.Pages.Admin.Users.EditModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AdminGerir)]
@{
    ViewData["Title"] = "Administração";
}
<partial name="_AdminNav" />
@if (Model.Entry is null)
{
    <div class="dmo-empty-state">
        <strong>Utilizador não encontrado</strong>
        <p><a href="/admin/users">Voltar à lista</a></p>
    </div>
}
else
{
    <div class="dmo-page-head">
        <div>
            <h2>Editar utilizador</h2>
            <p>Nome, título/função, template de acesso e estado.</p>
        </div>
        <a class="dmo-button" href="/admin/users">Voltar à lista</a>
    </div>
    <div class="dmo-card">
        <div class="dmo-modal-body">
            <div asp-validation-summary="All" class="dmo-form-message"></div>
            @if (!string.IsNullOrEmpty(Model.Feedback))
            {
                <div class="dmo-alert success" role="status">@Model.Feedback</div>
            }
            <form method="post" asp-page-handler="Save">
                <input type="hidden" name="id" value="@Model.Entry.ActorId" />
                <input type="hidden" name="version" value="@Model.Entry.UpdatedAtUtc.ToString("O")" />
                <div class="dmo-modal-grid">
                    <div class="dmo-field">
                        <label for="displayName">Nome</label>
                        <input id="displayName" name="displayName" type="text" required value="@Model.Entry.DisplayName" />
                    </div>
                    <div class="dmo-field">
                        <label for="templateId">Template de acesso</label>
                        <select id="templateId" name="templateId" required>
                            @foreach (var template in Model.Templates)
                            {
                                <option value="@template.TemplateId" selected="@(Model.Entry.TemplateId == template.TemplateId)">
                                    @template.Name (@(template.Active ? "ativo" : "inativo"))
                                </option>
                            }
                        </select>
                    </div>
                    <div class="dmo-field span2">
                        <label for="profileTitle">Título / função apresentado no cabeçalho</label>
                        <input id="profileTitle" name="profileTitle" type="text" maxlength="40"
                               placeholder="Ex.: Chefe, Engenheiro, Metrologia" value="@Model.Entry.ProfileTitle" />
                        <p class="dmo-field__helper">Texto visual livre; não altera permissões.</p>
                    </div>
                    <div class="dmo-field">
                        <label for="active">Estado</label>
                        <select id="active" name="active">
                            <option value="true" selected="@Model.Entry.Active">Ativo</option>
                            <option value="false" selected="@(!Model.Entry.Active)">Inativo</option>
                        </select>
                    </div>
                </div>
                <div class="dmo-modal-foot">
                    <a class="dmo-button" href="/admin/users">Cancelar</a>
                    <button type="submit" class="dmo-button"><span class="dmo-button__label">Guardar</span></button>
                </div>
            </form>
        </div>
    </div>
    @* Password reset: initiated entirely from the Admin UI through the
       privileged server-side adapter (04_ACC §9; TD-16). Interaction is the
       reference one (admin.html): explicit native confirmation before the
       submit; cancel aborts. The message travels as an HTML-encoded data
       attribute so the display name is never injected into script. *@
    <form method="post" asp-page-handler="ResetPassword"
          data-dmo-confirm-message="Iniciar reset de password para @Model.Entry.DisplayName?">
        <input type="hidden" name="id" value="@Model.Entry.ActorId" />
        <div class="dmo-row-actions">
            <button type="submit" class="dmo-button danger reset-password"
                    onclick="return confirm(this.form.getAttribute('data-dmo-confirm-message'))">
                Reset password
            </button>
        </div>
    </form>
}
