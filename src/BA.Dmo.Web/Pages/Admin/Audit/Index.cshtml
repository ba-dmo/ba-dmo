@page "/admin/audit"
@model BA.Dmo.Web.Pages.Admin.Audit.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AuditView)]
@{
    ViewData["Title"] = "Administração";

    string PillForResult(string result) => result switch
    {
        "succeeded" => "dmo-pill active",
        "corrected" => "dmo-pill",
        _ => "dmo-pill rejected"
    };

    string LabelForResult(string result) => result switch
    {
        "succeeded" => "Sucesso",
        "failed" => "Falha",
        "denied" => "Negado",
        "corrected" => "Corrigida",
        _ => result
    };
}
<partial name="_AdminNav" />
<div class="dmo-page-head">
    <div>
        <h2>Auditoria de ações</h2>
        <p>Histórico anual de ações executadas pelos utilizadores em todos os módulos.</p>
    </div>
</div>
<div asp-validation-summary="All" class="dmo-form-message"></div>
<form method="get" class="audit-filters audit-filters--auto dmo-card">
    <div class="dmo-field">
        <label for="year">Ano</label>
        <input id="year" name="year" type="number" value="@Model.Year" />
    </div>
    <div class="dmo-field">
        <label for="actor">Utilizador</label>
        <input id="actor" name="actor" type="text" value="@Model.Actor" />
    </div>
    <div class="dmo-field">
        <label for="module">Módulo</label>
        <input id="module" name="module" type="text" value="@Model.Module" />
    </div>
    <div class="dmo-field">
        <label for="action">Ação</label>
        <input id="action" name="action" type="text" value="@Model.Action" />
    </div>
    <div class="dmo-field">
        <label for="result">Resultado</label>
        <select id="result" name="result">
            <option value="">Todos</option>
            @foreach (var option in new[] { "succeeded", "failed", "denied", "corrected" })
            {
                <option value="@option" selected="@(Model.Result == option)">@LabelForResult(option)</option>
            }
        </select>
    </div>
    <div class="dmo-field">
        <label for="pageSize">Linhas</label>
        <select id="pageSize" name="pageSize">
            @foreach (var size in new[] { 20, 40, 60 })
            {
                <option value="@size" selected="@(Model.PageSize == size)">@size</option>
            }
        </select>
    </div>
    <button type="submit" class="dmo-button">Filtrar</button>
    @* Export POSTs the same filter values to the Export handler
       (formmethod override; asp-page-handler alone per the known
       tag-helper formaction constraint). Requires audit.export. *@
    <button type="submit" class="dmo-button" formmethod="post" asp-page-handler="Export"
            title="Requer audit.export">Exportar registo anual</button>
</form>
@if (Model.Events is not null)
{
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Events.TotalCount / (double)Model.Events.PageSize));
    var query = $"year={Model.Year}&actor={Uri.EscapeDataString(Model.Actor ?? string.Empty)}&module={Uri.EscapeDataString(Model.Module ?? string.Empty)}&action={Uri.EscapeDataString(Model.Action ?? string.Empty)}&result={Uri.EscapeDataString(Model.Result ?? string.Empty)}&pageSize={Model.PageSize}";
    <div class="dmo-card dmo-table-card">
        <div class="dmo-table-title">
            <div>
                <h3>Registo de @(Model.Year ?? 0)</h3>
                <p class="dmo-field__helper">Um clique seleciona; duplo clique não tem detalhe adicional nesta vista.</p>
            </div>
            <span class="dmo-pill">@Model.Events.TotalCount ação(ões)</span>
        </div>
        <div class="dmo-table-wrap">
            <table class="dmo-table">
                <thead>
                    <tr>
                        <th>Data/hora (UTC)</th>
                        <th>Utilizador</th>
                        <th>Módulo</th>
                        <th>Ação</th>
                        <th>Registo</th>
                        <th>Resultado</th>
                    </tr>
                </thead>
                <tbody data-dmo-list>
                    @foreach (var row in Model.Events.Rows)
                    {
                        <tr data-dmo-row data-id="@row.EntityId" aria-selected="false">
                            <td>@row.OccurredAtUtc.UtcDateTime.ToString("dd/MM/yyyy · HH:mm")</td>
                            <td>@(row.ActorNameSnapshot ?? row.ActorUserId ?? "—")</td>
                            <td>@row.ModuleId</td>
                            <td>@row.ActionCode</td>
                            <td>@row.EntityType · @row.EntityId</td>
                            <td><span class="@PillForResult(row.Result)">@LabelForResult(row.Result)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="dmo-pagination">
            <span>@Model.Events.TotalCount registo(s) · Página @Model.Events.Page de @totalPages</span>
            @if (Model.Events.Page > 1)
            {
                <a class="dmo-button dmo-icon-button" href="/admin/audit?@query&page=@(Model.Events.Page - 1)" aria-label="Página anterior">‹</a>
            }
            else
            {
                <button class="dmo-button dmo-icon-button" disabled aria-label="Página anterior">‹</button>
            }
            @if (Model.Events.Page * Model.Events.PageSize < Model.Events.TotalCount)
            {
                <a class="dmo-button dmo-icon-button" href="/admin/audit?@query&page=@(Model.Events.Page + 1)" aria-label="Página seguinte">›</a>
            }
            else
            {
                <button class="dmo-button dmo-icon-button" disabled aria-label="Página seguinte">›</button>
            }
        </div>
    </div>
}
