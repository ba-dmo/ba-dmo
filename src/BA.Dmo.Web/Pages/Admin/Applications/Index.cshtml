@page "/admin/applications"
@model BA.Dmo.Web.Pages.Admin.Applications.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AdminGerir)]
@{
    ViewData["Title"] = "Aplicações (catálogo)";
}
<main>
        <h1>Aplicações (catálogo)</h1>
        <p><a href="/admin">Administração</a></p>
        <p>
            O catálogo em código é a fonte de verdade; o espelho serve apenas a
            ordem/apresentação na Administração. Nunca concede acesso.
        </p>
        <div asp-validation-summary="All"></div>
        <form method="post">
            <table>
                <thead>
                    <tr>
                        <th>Módulo</th>
                        <th>Ordem</th>
                        <th>Ativo</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Entries.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Entries[i].DisplayName
                                <input type="hidden" name="entries[@i].ModuleId" value="@Model.Entries[i].ModuleId" />
                            </td>
                            <td><input type="number" name="entries[@i].DisplayOrder" value="@Model.Entries[i].DisplayOrder" /></td>
                            <td><input type="checkbox" name="entries[@i].Active" value="true" checked="@Model.Entries[i].Active" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="submit">Guardar</button>
            <a href="/admin">Cancelar</a>
        </form>
</main>
