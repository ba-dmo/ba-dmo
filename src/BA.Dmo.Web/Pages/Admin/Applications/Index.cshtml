@page "/admin/applications"
@model BA.Dmo.Web.Pages.Admin.Applications.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BA.Dmo.Web.Authorization.AdminPolicies.AdminGerir)]
@{
    ViewData["Title"] = "Administração";
}
<partial name="_AdminNav" />
<div class="dmo-page-head">
    <div>
        <h2>Aplicações (catálogo)</h2>
        <p>Gerir disponibilidade e ordem. O catálogo em código é a fonte de verdade; o espelho nunca concede acesso.</p>
    </div>
</div>
<div class="dmo-card">
    <div class="dmo-modal-body">
        <div asp-validation-summary="All" class="dmo-form-message"></div>
        <form method="post">
            <div class="dmo-table-wrap">
                <table class="dmo-table">
                    <thead>
                        <tr>
                            <th>Módulo</th>
                            <th>Ordem</th>
                            <th>Ativo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Entries.Count; i++)
                        {
                            <tr>
                                <td>
                                    <strong>@Model.Entries[i].DisplayName</strong>
                                    <input type="hidden" name="entries[@i].ModuleId" value="@Model.Entries[i].ModuleId" />
                                </td>
                                <td><input type="number" name="entries[@i].DisplayOrder" value="@Model.Entries[i].DisplayOrder" /></td>
                                <td><input type="checkbox" name="entries[@i].Active" value="true" checked="@Model.Entries[i].Active" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dmo-modal-foot">
                <a class="dmo-button" href="/admin">Cancelar</a>
                <button type="submit" class="dmo-button"><span class="dmo-button__label">Guardar</span></button>
            </div>
        </form>
    </div>
</div>
